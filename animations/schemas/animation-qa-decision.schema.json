{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "animation-qa-decision.schema.json",
  "title": "BG2 Upscale animation in-game QA decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "asset_id", "resref", "status", "result_kind", "decision_origin", "decision_date", "recorded_at_utc", "decision", "tested_areas"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "decision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "asset_id": {"type": "string", "pattern": "^animations:bam:(?=.*[A-Z0-9])[A-Z0-9_]{1,8}$"},
    "resref": {"type": "string", "pattern": "^(?=.*[A-Z0-9])[A-Z0-9_]{1,8}$"},
    "status": {"enum": ["accepted", "rejected"]},
    "result_kind": {"enum": ["x4", "native"]},
    "decision_origin": {"const": "explicit-user-ingame-qa"},
    "decision_date": {"type": "string", "format": "date"},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "decision": {"type": "string", "minLength": 1},
    "recipe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "correction_id": {"type": "string", "minLength": 1},
    "final_run": {"$ref": "#/$defs/artifact"},
    "native_source": {"$ref": "#/$defs/nativeSource"},
    "source_pack": {"$ref": "#/$defs/sourcePack"},
    "tested_areas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/areaId"}},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_runs", "source_packs"],
      "properties": {
        "source_runs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "source_packs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
      }
    }
  },
  "oneOf": [
    {
      "properties": {"result_kind": {"const": "x4"}},
      "required": ["final_run", "source_pack", "lineage"],
      "not": {"required": ["native_source"]}
    },
    {
      "properties": {"result_kind": {"const": "native"}},
      "required": ["native_source"],
      "not": {"anyOf": [{"required": ["correction_id"]}, {"required": ["final_run"]}, {"required": ["source_pack"]}, {"required": ["lineage"]}]}
    }
  ],
  "$defs": {
    "areaId": {"type": "string", "pattern": "^(AR|OH)[0-9]{4}$"},
    "relativePath": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "manifest_path", "manifest_sha256", "schema", "status"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "manifest_path": {"$ref": "#/$defs/relativePath"},
        "descriptor_path": {"$ref": "#/$defs/relativePath"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      }
    },
    "nativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "format", "frames", "inventory_path", "inventory_row_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^animations/ressources/[A-Z0-9_]{1,8}/source[.]bam$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "format": {"type": "string", "minLength": 1},
        "frames": {"type": "integer", "minimum": 1},
        "inventory_path": {"const": "animations/index/ressources.csv"},
        "inventory_row_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sourcePackArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "path", "manifest_path", "manifest_sha256", "registry_sha256", "resource_entries"],
      "properties": {
        "area": {"$ref": "#/$defs/areaId"},
        "path": {"$ref": "#/$defs/relativePath"},
        "manifest_path": {"$ref": "#/$defs/relativePath"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "resource_entries": {"type": "integer", "minimum": 1}
      }
    },
    "sourcePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "manifest_path", "manifest_sha256", "schema", "status", "areas"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "manifest_path": {"$ref": "#/$defs/relativePath"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "areas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourcePackArea"}}
      }
    }
  }
}
