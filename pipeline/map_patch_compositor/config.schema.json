{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BG2 map patch compositor configuration v1",
  "type": "object",
  "required": ["schema", "registration", "object_mask", "blend", "color", "output"],
  "properties": {
    "schema": {"const": "bg2-upscale-map-patch-compositor-config-v1"},
    "registration": {
      "type": "object",
      "properties": {
        "scale_min": {"type": "number", "exclusiveMinimum": 0},
        "scale_max": {"type": "number", "exclusiveMinimum": 0},
        "map_search_roi": {"type": ["array", "null"], "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
        "patch_exclude_rectangles": {"type": "array"},
        "map_exclude_rectangles": {"type": "array"}
      }
    },
    "object_mask": {"type": "object"},
    "blend": {"type": "object"},
    "color": {"type": "object"},
    "output": {"type": "object"}
  },
  "additionalProperties": false
}
