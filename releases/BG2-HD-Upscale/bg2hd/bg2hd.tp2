BEGIN @1
  DESIGNATED 0
  LABEL ~core-steam~
  INSTALL_BY_DEFAULT
  REQUIRE_PREDICATE GAME_IS ~bg2ee~ @11
  REQUIRE_COMPONENT ~EEEX/EEEX.TP2~ ~0~ @12
  REQUIRE_COMPONENT ~EEEX/EEEX.TP2~ ~1~ @13
  AT_NOW preflight_result ~powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File bg2hd/tools/bg2hd-steam.ps1 -Action Test~
  ACTION_IF preflight_result != 0 THEN BEGIN FAIL @17 END
  AT_NOW install_result ~powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File bg2hd/tools/bg2hd-steam.ps1 -Action Install~
  ACTION_IF install_result != 0 THEN BEGIN FAIL @18 END
  AT_UNINSTALL ~powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File bg2hd/tools/bg2hd-steam.ps1 -Action Uninstall~

