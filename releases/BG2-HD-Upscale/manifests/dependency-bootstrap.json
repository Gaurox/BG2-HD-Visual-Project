      "verify-official-or-managed-executable-layout",
      "verify-future-save-compatibility-guard",
      "verify-game-processes-are-closed",
      "verify-visual-cxx",
      "classify-eeex",
      "install-or-repair-eeex-outside-bg2hd-weidu-if-authorized",
      "revalidate-eeex",
      "launch-setup-bg2hd-in-place",
      "verify-steam-shim-and-installed-save-compatibility-guard"
    ],
    "network": "explicit-user-consent-required; verify-exact-archive-sha256; fail-closed",
    "offline": "accept-user-supplied-official-archive-only-after-exact-hash-verification"
  }
