{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "status", "source_tree", "build_environment", "files", "validation_required"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "pattern": "^iee-[0-9]+\\.[0-9]+\\.[0-9]+-alpha\\.[0-9]+$"},
    "status": {"enum": ["frozen-awaiting-clean-game-validation", "integrated-awaiting-clean-lifecycle-test", "integrated-in-place-awaiting-user-lifecycle-test", "validated", "rejected"]},
    "source_tree": {"type": "string", "minLength": 1},
    "build_environment": {"type": "object", "required": ["cmake", "generator", "compiler", "build_type"]},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}}},
    "validation_required": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
