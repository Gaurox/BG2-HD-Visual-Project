{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_by", "candidates"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "generated_by": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "component_id", "component_label", "payload_group", "approval_status", "resources", "runtime_pack", "renderer_contract", "payload_projection"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "component_id": {"type": "integer", "minimum": 1},
          "component_label": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "payload_group": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "approval_status": {"const": "approved-for-release"},
          "resources": {"type": "array", "minItems": 1},
          "runtime_pack": {"type": "object"},
          "renderer_contract": {"type": "object"},
          "integration_evidence": {"type": "object", "required": ["path", "bytes", "sha256"]},
          "runtime_files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source", "destination", "bytes", "sha256"], "properties": {"source": {"type": "string", "pattern": "^releases/BG2-HD-Upscale/release-inputs/effects/[A-Za-z0-9._/-]+$"}, "destination": {"type": "string", "pattern": "^override/[A-Za-z0-9_]{1,8}[.](bam|vvc|pro)$"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}}}},
          "payload_projection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "content_manifest_integration", "reason"],
            "properties": {
              "status": {"enum": ["pending-effect-release-generator", "integrated"]},
              "content_manifest_integration": {"type": "boolean"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
