{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_by",
    "candidates"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 2
    },
    "generated_by": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "component_id",
          "component_label",
          "payload_group",
          "approval_status",
          "distribution",
          "kind",
          "area",
          "destination_root",
          "asset_scope",
          "source_pack",
          "qa_approval",
          "runtime_contract",
          "payload_projection"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "component_id": {
            "enum": [
              4200,
              4210
            ]
          },
          "component_label": {
            "type": "string",
            "minLength": 1
          },
          "payload_group": {
            "type": "string",
            "minLength": 1
          },
          "approval_status": {
            "const": "approved-for-release"
          },
          "distribution": {
            "const": "local-test-only"
          },
          "kind": {
            "enum": [
              "sprite",
              "paperdoll"
            ]
          },
          "area": {
            "enum": [
              "SPRITES",
              "UI"
            ]
          },
          "destination_root": {
            "enum": [
              "iee-assets/creature-sprites",
              "iee-assets/paperdolls"
            ]
          },
          "asset_scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "animation_ids",
              "file_count",
              "bytes"
            ],
            "properties": {
              "animation_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^0x[A-F0-9]{4}$"
                }
              },
              "file_count": {
                "type": "integer",
                "minimum": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "source_pack": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[A-F0-9]{64}$"
              }
            }
          },
          "qa_approval": {
            "type": "object",
            "required": [
              "qa_state",
              "filter",
              "evidence",
              "new_ingame_qa"
            ],
            "properties": {
              "qa_state": {
                "const": "passed"
              },
              "filter": {
                "const": "Nearest"
              },
              "evidence": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[A-F0-9]{64}$"
                    }
                  }
                }
              },
              "new_ingame_qa": {
                "const": false
              }
            }
          },
          "runtime_contract": {
            "type": "object",
            "required": [
              "bundle_id",
              "dll_sha256",
              "scale",
              "filter",
              "registry_versions"
            ],
            "properties": {
              "bundle_id": {
                "type": "string",
                "minLength": 1
              },
              "dll_sha256": {
                "type": "string",
                "pattern": "^[A-F0-9]{64}$"
              },
              "scale": {
                "const": 2
              },
              "filter": {
                "const": "Nearest"
              },
              "registry_versions": {
                "type": "array",
                "items": {
                  "enum": [
                    6,
                    7,
                    9
                  ]
                }
              }
            }
          },
          "payload_projection": {
            "type": "object",
            "required": [
              "status",
              "content_manifest_integration",
              "reason"
            ],
            "properties": {
              "status": {
                "const": "integrated"
              },
              "content_manifest_integration": {
                "const": true
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
