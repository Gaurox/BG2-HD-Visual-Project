    "components": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "name", "status", "depends_on", "payload_groups"], "properties": {"id": {"type": "integer", "minimum": 0}, "label": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "name": {"type": "string", "minLength": 1}, "status": {"enum": ["blocked", "validated", "deprecated"]}, "depends_on": {"type": "array", "items": {"type": "integer", "minimum": 0}}, "payload_groups": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}}, "reason": {"type": "string"}}}}
  }
