{
  "schema": "bg2-upscale-workspace-paths-v1",
  "local_override": "config/workspace-paths.local.json",
  "authority_policy": "Machine-independent path keys only. Values belong in the ignored local override or matching environment variables.",
  "paths": {
    "installer_backup_root": {
      "environment": "BG2HD_INSTALLER_BACKUP_ROOT",
      "kind": "directory",
      "markers": []
    },
    "full_project_backup_source": {
      "environment": "BG2HD_FULL_BACKUP_SOURCE",
      "kind": "directory",
      "markers": [".git", "AGENTS.md"]
    },
    "full_project_backup_root": {
      "environment": "BG2HD_FULL_BACKUP_ROOT",
      "kind": "directory",
      "markers": []
    },
    "bg2ee_game_root": {
      "environment": "BG2EE_GAME_ROOT",
      "legacy_environments": [
        "BG2EE_GAME_DIR"
      ],
      "kind": "directory",
      "markers": [
        "chitin.key"
      ]
    },
    "website_checkout": {
      "environment": "BG2HD_WEBSITE_ROOT",
      "kind": "directory",
      "markers": [
        ".git",
        "index.html"
      ]
    },
    "mmpx_scalepix": {
      "environment": "BG2EE_MMPX_SCALEPIX",
      "kind": "file"
    },
    "chainner_exe": {
      "environment": "BG2EE_CHAINNER_EXE",
      "kind": "file"
    },
    "chainner_python": {
      "environment": "BG2EE_CHAINNER_PYTHON",
      "kind": "file"
    },
    "reboutcx_model": {
      "environment": "BG2EE_REBOUTCX_MODEL",
      "kind": "file"
    },
    "reboutcx_chain": {
      "environment": "BG2EE_REBOUTCX_CHAIN",
      "kind": "file"
    },
    "comfyui_root": {
      "environment": "BG2EE_COMFYUI_ROOT",
      "kind": "directory",
      "markers": ["main.py"]
    },
    "comfyui_python": {
      "environment": "BG2EE_COMFYUI_PYTHON",
      "kind": "file"
    },
    "seedvr_models": {
      "environment": "BG2EE_SEEDVR_MODELS",
      "kind": "directory",
      "markers": ["seedvr2_ema_3b_fp16.safetensors", "ema_vae_fp16.safetensors"]
    },
    "topaz_gigapixel_exe": {
      "environment": "BG2EE_TOPAZ_EXE",
      "kind": "file"
    },
    "topaz_video_ffmpeg": {
      "environment": "BG2EE_TOPAZ_VIDEO_FFMPEG",
      "kind": "file"
    },
    "topaz_video_models": {
      "environment": "BG2EE_TOPAZ_VIDEO_MODELS",
      "kind": "directory",
      "markers": []
    },
    "animation_artifacts_archive": {
      "environment": "BG2HD_ANIMATION_ARTIFACTS_ARCHIVE",
      "kind": "directory",
      "markers": []
    }
  },
  "services": {
    "comfyui_url": {
      "environment": "BG2EE_COMFYUI_URL",
      "default": "http://127.0.0.1:8188"
    }
  }
}
