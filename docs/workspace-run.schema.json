{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-run.schema.json",
  "title": "BG2 Upscale workspace run descriptor",
  "description": "Minimal descriptor for new domains that do not already have a stronger native run contract. Selection remains external to the sealed run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "run_id",
    "domain",
    "asset_ids",
    "pipeline",
    "inputs",
    "outputs",
    "provenance",
    "result"
  ],
  "properties": {
    "$schema": {
      "const": "docs/workspace-run.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "domain": {
      "enum": [
        "maps",
        "animations",
        "sprites",
        "ui",
        "portraits",
        "videos",
        "icons",
        "cursors",
        "effects",
        "projectiles"
      ]
    },
    "asset_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "recipe_path", "recipe_sha256"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "recipe_path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "recipe_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileEvidence"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileEvidence"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at_utc", "generator"],
      "properties": {
        "created_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sealed"],
      "properties": {
        "status": {
          "enum": ["planned", "running", "completed", "failed", "cancelled"]
        },
        "sealed": {
          "type": "boolean"
        },
        "completed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "bytes"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
